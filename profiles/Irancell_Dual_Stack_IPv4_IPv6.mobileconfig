<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>APNs</key>
			<array>
				<dict>
					<key>Name</key>
					<string>mtnirancell</string>
					<key>AllowedProtocolMask</key>
					<integer>3</integer>
					<key>AllowedProtocolMaskInRoaming</key>
					<integer>3</integer>
					<key>AllowedProtocolMaskInDomesticRoaming</key>
					<integer>3</integer>
				</dict>
			</array>
			<key>PayloadDisplayName</key>
			<string>Irancell Cellular Data - Dual Stack</string>
			<key>PayloadDescription</key>
			<string>Configures mtnirancell data APN to allow IPv4 and IPv6 on the preferred cellular data line.</string>
			<key>PayloadIdentifier</key>
			<string>net.local.custom.irancell.dualstack.cellular</string>
			<key>PayloadType</key>
			<string>com.apple.cellular</string>
			<key>PayloadUUID</key>
			<string>0E1649BC-6E87-4FB0-9AEF-9C1AC78EFEE0</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>Irancell - IPv4 + IPv6 (Dual Stack)</string>
	<key>PayloadDescription</key>
	<string>Personal unsigned APN profile for MTN Irancell. APN mtnirancell; permits both IPv4 and IPv6 for cellular data. Actual IP connectivity depends on carrier support. Remove this profile to revert.</string>
	<key>PayloadIdentifier</key>
	<string>net.local.custom.irancell.dualstack.profile</string>
	<key>PayloadOrganization</key>
	<string>Personal APN Configuration (Unofficial)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>686D902B-9884-4984-8E2E-5661AD1EE7DA</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>