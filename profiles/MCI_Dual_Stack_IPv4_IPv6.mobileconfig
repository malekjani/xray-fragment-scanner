<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>APNs</key>
			<array>
				<dict>
					<key>Name</key>
					<string>mcinet</string>
					<key>AllowedProtocolMask</key>
					<integer>3</integer>
					<key>AllowedProtocolMaskInRoaming</key>
					<integer>3</integer>
					<key>AllowedProtocolMaskInDomesticRoaming</key>
					<integer>3</integer>
				</dict>
			</array>
			<key>PayloadDisplayName</key>
			<string>MCI Cellular Data - Dual Stack</string>
			<key>PayloadDescription</key>
			<string>Configures mcinet cellular data APN to allow IPv4 and IPv6 on the preferred data SIM.</string>
			<key>PayloadIdentifier</key>
			<string>net.local.custom.mci.dualstack.cellular</string>
			<key>PayloadType</key>
			<string>com.apple.cellular</string>
			<key>PayloadUUID</key>
			<string>A425A1AB-C0BC-4760-9F83-66E9A99BD117</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>MCI - IPv4 + IPv6 (Dual Stack)</string>
	<key>PayloadDescription</key>
	<string>Custom, unsigned APN profile for MCI (Hamrahe Aval): mcinet, allows IPv4 and IPv6 for cellular data. Actual IPv6 connectivity depends on the carrier. Remove this profile to revert.</string>
	<key>PayloadIdentifier</key>
	<string>net.local.custom.mci.dualstack.profile</string>
	<key>PayloadOrganization</key>
	<string>Personal APN Configuration (Unofficial)</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>0566A3CB-FB26-4BFB-B578-AF8F515A6440</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>