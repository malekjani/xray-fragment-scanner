#!/usr/bin/env bash

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

XRAY_PATH="/usr/local/bin/xray"
CONFIG_PATH="$PROJECT_DIR/config.json"

LOG_DIR="$PROJECT_DIR/logs"
mkdir -p "$LOG_DIR"

LOG_FILE="$LOG_DIR/pings.txt"
XRAY_LOG_FILE="$LOG_DIR/xraylogs.txt"
XRAY_ERROR_LOG_FILE="$LOG_DIR/xraylogs.error.txt"
CONFIG_BACKUP="$PROJECT_DIR/config.json.backup-before-fragment-scanner"

HTTP_PROXY_SERVER="127.0.0.1"
XRAY_PID=""
XRAY_SERVICE_WAS_ACTIVE=0

if [[ "$EUID" -ne 0 ]]; then
    echo "Error: Please run this script with sudo:"
    echo "sudo $0"
    exit 1
fi

for cmd in curl jq awk sort head cut sed grep python3; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: '$cmd' is not installed."
        echo "Install dependencies with:"
        echo "sudo apt update && sudo apt install -y curl jq python3"
        exit 1
    fi
done

capture_xray_service_state() {
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet xray; then
        XRAY_SERVICE_WAS_ACTIVE=1
    fi
}

install_or_update_xray() {
    local latest_version=""
    local installed_version=""

    echo "Checking Xray version..."

    latest_version="$(
        curl -fsSL https://api.github.com/repos/XTLS/Xray-core/releases/latest \
        | jq -r '.tag_name' \
        | sed 's/^v//'
    )"

    if [[ -z "$latest_version" || "$latest_version" == "null" ]]; then
        echo "Error: Could not detect latest Xray version."
        exit 1
    fi

    if [[ -x "$XRAY_PATH" ]]; then
        installed_version="$("$XRAY_PATH" version 2>/dev/null | awk 'NR==1 {print $2}' | sed 's/^v//')"

        if [[ -z "$installed_version" ]]; then
            installed_version="$("$XRAY_PATH" -version 2>/dev/null | awk 'NR==1 {print $2}' | sed 's/^v//')"
        fi
    fi

    if [[ -z "$installed_version" ]]; then
        echo "Xray is not installed. Installing latest version: $latest_version"
        bash -c "$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
    elif [[ "$installed_version" != "$latest_version" ]]; then
        echo "Xray update required."
        echo "Installed: $installed_version"
        echo "Latest:    $latest_version"
        bash -c "$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
    else
        echo "Xray is already up to date: $installed_version"
    fi

    if [[ ! -x "$XRAY_PATH" ]]; then
        echo "Error: Xray binary not found at $XRAY_PATH"
        exit 1
    fi
}

generate_config_from_vless_link() {
    local vless_link=""

    echo "config.json not found in script directory."
    read -r -p "Enter VLESS link: " vless_link

    if [[ -z "$vless_link" ]]; then
        echo "Error: VLESS link is empty."
        exit 1
    fi

    python3 - "$vless_link" "$CONFIG_PATH" <<'PY'
import json
import sys
from urllib.parse import urlsplit, parse_qs, unquote

link = sys.argv[1].strip()
output_path = sys.argv[2]

parsed = urlsplit(link)

if parsed.scheme.lower() != "vless":
    raise SystemExit("Error: Only vless:// links are supported.")

query = parse_qs(parsed.query, keep_blank_values=True)

def q(name, default=""):
    value = query.get(name, [default])[0]
    return unquote(value) if isinstance(value, str) else value

def q_bool(*names):
    for name in names:
        value = q(name, "").strip().lower()
        if value in ("1", "true", "yes"):
            return True
    return False

uuid = unquote(parsed.username or "")
address = parsed.hostname
port = parsed.port or 443

if not uuid:
    raise SystemExit("Error: UUID not found in VLESS link.")

if not address:
    raise SystemExit("Error: Server address not found in VLESS link.")

remark = unquote(parsed.fragment or "VLESS-Xray")

network = q("type", "tcp") or "tcp"
security = q("security", "none") or "none"
encryption = q("encryption", "none") or "none"

sni = q("sni", "")
host = q("host", "")
path = q("path", "/") or "/"
mode = q("mode", "auto") or "auto"
fingerprint = q("fp", "")
flow = q("flow", "")

alpn_raw = q("alpn", "")
alpn = [item.strip() for item in alpn_raw.split(",") if item.strip()]

proxy_settings = {
    "address": address,
    "port": port,
    "id": uuid,
    "encryption": encryption
}

if flow:
    proxy_settings["flow"] = flow

stream_settings = {
    "network": network,
    "security": security,
    "sockopt": {
        "dialerProxy": "fragment",
        "tcpKeepAliveIdle": 100,
        "tcpNoDelay": True
    }
}

if security == "tls":
    tls_settings = {
        "allowInsecure": q_bool("insecure", "allowInsecure"),
        "serverName": sni or host or address
    }

    if fingerprint:
        tls_settings["fingerprint"] = fingerprint

    if alpn:
        tls_settings["alpn"] = alpn

    stream_settings["tlsSettings"] = tls_settings

elif security == "reality":
    reality_settings = {
        "serverName": sni or host or address
    }

    public_key = q("pbk", "")
    short_id = q("sid", "")
    spider_x = q("spx", "")

    if fingerprint:
        reality_settings["fingerprint"] = fingerprint

    if public_key:
        reality_settings["publicKey"] = public_key

    if short_id:
        reality_settings["shortId"] = short_id

    if spider_x:
        reality_settings["spiderX"] = spider_x

    stream_settings["realitySettings"] = reality_settings

if network == "xhttp":
    xhttp_settings = {
        "path": path,
        "mode": mode
    }

    if host:
        xhttp_settings["host"] = host

    stream_settings["xhttpSettings"] = xhttp_settings

elif network == "ws":
    ws_settings = {
        "path": path
    }

    if host:
        ws_settings["headers"] = {
            "Host": host
        }

    stream_settings["wsSettings"] = ws_settings

elif network == "websocket":
    stream_settings["network"] = "ws"

    ws_settings = {
        "path": path
    }

    if host:
        ws_settings["headers"] = {
            "Host": host
        }

    stream_settings["wsSettings"] = ws_settings

elif network == "grpc":
    service_name = q("serviceName", "")
    grpc_settings = {}

    if service_name:
        grpc_settings["serviceName"] = service_name

    stream_settings["grpcSettings"] = grpc_settings

elif network == "httpupgrade":
    httpupgrade_settings = {
        "path": path
    }

    if host:
        httpupgrade_settings["host"] = host

    stream_settings["httpupgradeSettings"] = httpupgrade_settings

config = {
    "remarks": remark,
    "log": {
        "access": "",
        "error": "",
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "tag": "socks",
            "port": 10808,
            "listen": "127.0.0.1",
            "protocol": "socks",
            "sniffing": {
                "enabled": True,
                "destOverride": [
                    "http",
                    "tls"
                ],
                "routeOnly": False
            },
            "settings": {
                "auth": "noauth",
                "udp": True
            }
        },
        {
            "tag": "http",
            "port": 10809,
            "listen": "127.0.0.1",
            "protocol": "http",
            "sniffing": {
                "enabled": True,
                "destOverride": [
                    "http",
                    "tls"
                ],
                "routeOnly": False
            },
            "settings": {
                "allowTransparent": False
            }
        }
    ],
    "outbounds": [
        {
            "tag": "proxy",
            "protocol": "vless",
            "settings": proxy_settings,
            "streamSettings": stream_settings
        },
        {
            "tag": "fragment",
            "protocol": "freedom",
            "settings": {
                "domainStrategy": "AsIs",
                "fragment": {
                    "packets": "tlshello",
                    "length": "10-20",
                    "interval": "10-20"
                }
            },
            "streamSettings": {
                "sockopt": {
                    "tcpNoDelay": True,
                    "tcpKeepAliveIdle": 100
                }
            }
        },
        {
            "tag": "direct",
            "protocol": "freedom",
            "settings": {}
        },
        {
            "tag": "block",
            "protocol": "blackhole",
            "settings": {
                "response": {
                    "type": "http"
                }
            }
        }
    ],
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "type": "field",
                "port": "0-65535",
                "outboundTag": "proxy"
            }
        ]
    }
}

with open(output_path, "w", encoding="utf-8") as f:
    json.dump(config, f, indent=2, ensure_ascii=False)

print(f"Generated config: {output_path}")
PY
}

check_config() {
    if [[ ! -f "$CONFIG_PATH" ]]; then
        generate_config_from_vless_link
    fi

    if ! jq empty "$CONFIG_PATH" >/dev/null 2>&1; then
        echo "Error: config.json is not valid JSON."
        exit 1
    fi

    if ! jq -e '.outbounds[]? | select(.tag == "fragment")' "$CONFIG_PATH" >/dev/null; then
        echo "Error: No outbound with tag 'fragment' found in config.json"
        exit 1
    fi

    if ! jq -e '.outbounds[]? | select(.tag == "proxy") | .streamSettings.sockopt.dialerProxy == "fragment"' "$CONFIG_PATH" >/dev/null; then
        echo "Warning: proxy outbound does not use dialerProxy=fragment."
        echo "The scanner can still modify fragment values, but the proxy may not use them."
    fi

    if [[ ! -f "$CONFIG_BACKUP" ]]; then
        cp "$CONFIG_PATH" "$CONFIG_BACKUP"
        echo "Config backup created:"
        echo "$CONFIG_BACKUP"
    fi
}

prepare_logs() {
    : > "$LOG_FILE"
    : > "$XRAY_LOG_FILE"
    : > "$XRAY_ERROR_LOG_FILE"
}

stop_xray_process() {
    if [[ -n "${XRAY_PID:-}" ]] && kill -0 "$XRAY_PID" 2>/dev/null; then
        kill "$XRAY_PID" 2>/dev/null
        wait "$XRAY_PID" 2>/dev/null || true
    fi

    XRAY_PID=""
}

stop_xray_service_if_running() {
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet xray; then
        echo "Stopping active xray service temporarily..."
        systemctl stop xray
    fi
}

restore_xray_service() {
    if [[ "$XRAY_SERVICE_WAS_ACTIVE" -eq 1 ]]; then
        echo "Restoring xray service..."
        systemctl start xray 2>/dev/null || true
    fi
}

modify_config() {
    local packets="$1"
    local length="$2"
    local interval="$3"
    local tmp_file=""

    tmp_file="$(mktemp)"

    if ! jq \
        --arg packets "$packets" \
        --arg length "$length" \
        --arg interval "$interval" \
        '
        (.outbounds[] | select(.tag == "fragment") | .settings.fragment.packets) = $packets |
        (.outbounds[] | select(.tag == "fragment") | .settings.fragment.length) = $length |
        (.outbounds[] | select(.tag == "fragment") | .settings.fragment.interval) = $interval
        ' "$CONFIG_PATH" > "$tmp_file"; then
        rm -f "$tmp_file"
        echo "Error: Failed to modify config.json"
        exit 1
    fi

    mv "$tmp_file" "$CONFIG_PATH"
}

get_random_value() {
    local -n arr="$1"
    echo "${arr[$(( RANDOM % ${#arr[@]} ))]}"
}

get_unique_combination() {
    local packets=""
    local length=""
    local interval=""
    local combination=""

    while true; do
        packets="$(get_random_value packetsOptions)"
        length="$(get_random_value lengthOptions)"
        interval="$(get_random_value intervalOptions)"

        combination="${packets},${length},${interval}"

        if [[ -z "${USED_COMBINATIONS[$combination]+x}" ]]; then
            USED_COMBINATIONS["$combination"]=1
            echo "$packets|$length|$interval"
            return
        fi
    done
}

send_http_request() {
    local ping_count="$1"
    local timeout_sec="$2"
    local timeout_ms=$(( timeout_sec * 1000 ))
    local url="http://cp.cloudflare.com"
    local times=()
    local elapsed=""
    local rc=0
    local ms=""
    local total="0"
    local valid=0
    local failed=0
    local avg="0"

    for ((i = 1; i <= ping_count; i++)); do
        elapsed="$(
            curl \
                --silent \
                --output /dev/null \
                --write-out "%{time_total}" \
                --max-time "$timeout_sec" \
                --proxy "http://${HTTP_PROXY_SERVER}:${HTTP_PROXY_PORT}" \
                "$url" 2>/dev/null
        )"
        rc=$?

        if [[ $rc -eq 0 && "$elapsed" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            ms="$(awk -v t="$elapsed" 'BEGIN { printf "%.2f", t * 1000 }')"
            times+=("$ms")
        else
            times+=("-1")
        fi

        sleep 1
    done

    times=("${times[@]:1}")

    echo "Individual Ping Times:" >> "$LOG_FILE"
    IFS=','; echo "${times[*]}" >> "$LOG_FILE"; unset IFS

    for t in "${times[@]}"; do
        if [[ "$t" == "-1" ]]; then
            ((failed++))
        else
            total="$(awk -v a="$total" -v b="$t" 'BEGIN { print a + b }')"
            ((valid++))
        fi
    done

    if (( valid > 0 )); then
        avg="$(awk -v total="$total" -v failed="$failed" -v timeout="$timeout_ms" -v n="${#times[@]}" \
            'BEGIN { printf "%.2f", (total + failed * timeout) / n }')"
    else
        avg="0"
    fi

    echo "$avg"
}

trap 'stop_xray_process; restore_xray_service' EXIT

capture_xray_service_state
install_or_update_xray
stop_xray_service_if_running
check_config
prepare_logs

read -r -p "Enter the number of instances default 10: " InstancesInput
read -r -p "Enter timeout for each request in seconds default 10: " TimeoutSecInput
read -r -p "Enter HTTP listening port default 10809: " HTTPProxyPortInput
read -r -p "Enter number of requests per instance default 3: " PingCountInput

Instances="${InstancesInput:-10}"
TimeoutSec="${TimeoutSecInput:-10}"
HTTP_PROXY_PORT="${HTTPProxyPortInput:-10809}"

if [[ -n "${PingCountInput}" ]]; then
    PingCount=$((PingCountInput + 1))
else
    PingCount=4
fi

packetsOptions=("tlshello" "1-1" "1-2" "1-3" "1-5")

lengthOptions=(
    "1-1" "1-2" "1-3" "2-5" "1-5" "1-10"
    "3-5" "5-10" "3-10" "10-15" "10-30"
    "10-20" "20-50" "50-100" "100-150"
)

intervalOptions=(
    "1-1" "1-2" "3-5" "1-5" "5-10" "10-15"
    "10-20" "20-30" "20-50" "40-50" "50-100"
    "50-80" "100-150" "150-200" "100-200"
)

maxPossibleInstances=$(( ${#packetsOptions[@]} * ${#lengthOptions[@]} * ${#intervalOptions[@]} ))

while (( Instances > maxPossibleInstances )); do
    echo "Error: Number of instances cannot be greater than $maxPossibleInstances"
    read -r -p "Enter the number of instances default 10: " InstancesInput
    Instances="${InstancesInput:-10}"
done

declare -A USED_COMBINATIONS
declare -a RESULTS

printf '+--------------+-----------------+---------------+-----------------+---------------+\n'
printf '|   Instance   |     Packets     |    Length     |    Interval     | Average Ping  |\n'
printf '+--------------+-----------------+---------------+-----------------+---------------+\n'

for ((i = 0; i < Instances; i++)); do
    combination="$(get_unique_combination)"

    packets="$(echo "$combination" | cut -d'|' -f1)"
    length="$(echo "$combination" | cut -d'|' -f2)"
    interval="$(echo "$combination" | cut -d'|' -f3)"

    modify_config "$packets" "$length" "$interval"

    stop_xray_process

    "$XRAY_PATH" run -c "$CONFIG_PATH" > "$XRAY_LOG_FILE" 2> "$XRAY_ERROR_LOG_FILE" &
    XRAY_PID=$!

    sleep 3

    if ! kill -0 "$XRAY_PID" 2>/dev/null; then
        echo
        echo "Error: Xray failed to start."
        echo "Check error log:"
        echo "$XRAY_ERROR_LOG_FILE"
        exit 1
    fi

    echo "Testing with packets=$packets, length=$length, interval=$interval..." >> "$LOG_FILE"

    averagePing="$(send_http_request "$PingCount" "$TimeoutSec")"

    echo "Average Ping Time: $averagePing ms" >> "$LOG_FILE"
    echo >> "$LOG_FILE"

    RESULTS+=("${averagePing}|$((i + 1))|${packets}|${length}|${interval}")

    printf '|    %-9s | %-15s | %-13s | %-15s | %-13s |\n' \
        "$((i + 1))" "$packets" "$length" "$interval" "$averagePing"

    sleep 1
done

printf '+--------------+-----------------+---------------+-----------------+---------------+\n'

echo
echo "Top three lowest average response times:"
echo

printf '%-10s %-12s %-12s %-12s %-24s\n' \
    "Instance" "Packets" "Length" "Interval" "AverageResponseTime(ms)"

printf '%s\n' "${RESULTS[@]}" \
    | awk -F'|' '$1 > 0 { print }' \
    | sort -t'|' -k1,1n \
    | head -n 3 \
    | while IFS='|' read -r avg instance packets length interval; do
        printf '%-10s %-12s %-12s %-12s %-24s\n' \
            "$instance" "$packets" "$length" "$interval" "$avg"
      done

stop_xray_process

echo
echo "Files:"
echo "Config:        $CONFIG_PATH"
echo "Config backup: $CONFIG_BACKUP"
echo "Ping log:      $LOG_FILE"
echo "Xray log:      $XRAY_LOG_FILE"
echo "Xray errors:   $XRAY_ERROR_LOG_FILE"

read -r -p "Press Enter to exit..."
