#!/usr/bin/env bash

set -uo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# New modes operate as an unprivileged process and never touch systemd/Xray installs.
if [[ "${1:-}" == "--method" ]]; then
    exec python3 "$PROJECT_ROOT/lib/network_scan.py" "$@"
fi

if [[ $# -eq 0 ]]; then
    echo "Xray Finalmask Scanner"
    echo "1) Existing fragment modes (legacy, finalmask, header-custom)"
    echo "2) IP + ECH matrix (Rightel / MCI experiment)"
    echo "3) IP + FinalMask / unsafe / cipher matrix (Irancell experiment)"
    read -r -p "Select [1]: " startup_mode
    case "${startup_mode:-1}" in
        2) exec python3 "$PROJECT_ROOT/lib/network_scan.py" --method ech ;;
        3) exec python3 "$PROJECT_ROOT/lib/network_scan.py" --method irancell ;;
        1) ;;
        *) echo "Unknown mode" >&2; exit 2 ;;
    esac
fi

source "$PROJECT_ROOT/lib/env.sh"
source "$PROJECT_ROOT/lib/ui.sh"
source "$PROJECT_ROOT/lib/checks.sh"
source "$PROJECT_ROOT/lib/xray.sh"
source "$PROJECT_ROOT/lib/config.sh"
source "$PROJECT_ROOT/lib/options.sh"
source "$PROJECT_ROOT/lib/scanner.sh"

trap 'stop_xray_process; restore_xray_service' EXIT

main() {
    require_root
    check_dependencies
    capture_xray_service_state
    install_or_update_xray
    stop_xray_service_if_running
    check_config
    prepare_logs
    read_scan_options
    load_scan_options
    validate_instance_count
    run_scan
    print_top_results
    stop_xray_process
    print_output_files
    read -r -p "Press Enter to exit..."
}

main "$@"
