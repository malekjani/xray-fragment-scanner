#!/usr/bin/env bash

set -uo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# All modern/live scans select the latest official prerelease via core_manager.py.
if [[ "${1:-}" == "--core" || "${1:-}" == "--update-core" ]]; then
    exec python3 "$PROJECT_ROOT/lib/core_manager.py" --ensure
fi
if [[ "${1:-}" == "--latest-core" ]]; then
    exec python3 "$PROJECT_ROOT/lib/core_manager.py" --latest
fi

# Validate an existing scan without re-entering a private URL or running a network scan.
if [[ "${1:-}" == "--diagnose" ]]; then
    shift
    exec python3 "$PROJECT_ROOT/lib/diagnose.py" "$@"
fi

# V8 draft entry points: local-only dashboard and fixed-matrix engine.
if [[ "${1:-}" == "--web" || "${1:-}" == "--v8-web" ]]; then
    shift
    exec python3 "$PROJECT_ROOT/lib/v8_web.py" "$@"
fi
if [[ "${1:-}" == "--method" && "${2:-}" == "v8" ]]; then
    shift 2
    exec python3 "$PROJECT_ROOT/lib/v8_engine.py" "$@"
fi

# New modes operate as an unprivileged process and never touch systemd/Xray installs.
if [[ "${1:-}" == "--method" && "${2:-}" == "optimize" ]]; then
    shift 2
    exec python3 "$PROJECT_ROOT/lib/optimize.py" "$@"
fi
if [[ "${1:-}" == "--method" ]]; then
    exec python3 "$PROJECT_ROOT/lib/network_scan.py" "$@"
fi

if [[ $# -eq 0 || "${1:-}" == "--interactive" || "${1:-}" == "--wizard" ]]; then
    exec python3 "$PROJECT_ROOT/lib/v8_wizard.py"
fi

if [[ "${1:-}" == "--v7-wizard" ]]; then
    shift
    exec python3 "$PROJECT_ROOT/lib/wizard.py" "$@"
fi

if [[ "${1:-}" == "--legacy-menu" ]]; then
    echo "Xray Finalmask Scanner"
    echo "1) Historical Bash mode (explicit opt-in; see --legacy-system-mode)"
    echo "2) IP + ECH matrix (Rightel / MCI experiment)"
    echo "3) IP + FinalMask / unsafe / cipher matrix (Irancell experiment)"
    echo "4) Optimize fragments/finalmask + export VLESS links and analytics"
    read -r -p "Select [4]: " startup_mode
    case "${startup_mode:-4}" in
        2) exec python3 "$PROJECT_ROOT/lib/network_scan.py" --method ech ;;
        3) exec python3 "$PROJECT_ROOT/lib/network_scan.py" --method irancell ;;
        4) exec python3 "$PROJECT_ROOT/lib/optimize.py" ;;
        1) echo "Historical mode requires --legacy-system-mode; opening the safe modern wizard." >&2
           exec python3 "$PROJECT_ROOT/lib/v8_wizard.py" ;;
        *) echo "Unknown mode" >&2; exit 2 ;;
    esac
fi

if [[ "${1:-}" != "--legacy-system-mode" ]]; then
    echo "Use the interactive wizard or --method optimize|ech|irancell. Historical service-changing mode needs --legacy-system-mode." >&2
    exit 2
fi
shift

source "$PROJECT_ROOT/lib/env.sh"
source "$PROJECT_ROOT/lib/ui.sh"
source "$PROJECT_ROOT/lib/checks.sh"
source "$PROJECT_ROOT/lib/xray.sh"
source "$PROJECT_ROOT/lib/config.sh"
source "$PROJECT_ROOT/lib/options.sh"
source "$PROJECT_ROOT/lib/scanner.sh"

trap 'stop_xray_process; restore_xray_service' EXIT

main() {
    require_root
    check_dependencies
    capture_xray_service_state
    install_or_update_xray
    stop_xray_service_if_running
    check_config
    prepare_logs
    read_scan_options
    load_scan_options
    validate_instance_count
    run_scan
    print_top_results
    stop_xray_process
    print_output_files
    read -r -p "Press Enter to exit..."
}

main "$@"
